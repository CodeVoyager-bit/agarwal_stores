# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/agarwal_fatake
# 32+ random characters, keep it stable: openssl rand -hex 32
AUTH_SECRET=
# 10-digit mobile numbers (comma separated) that get the /admin pages after logging in
ADMIN_PHONES=

# Development only: no SMS is sent and MOCK_OTP_CODE is the login code. Ignored in production.
MOCK_OTP=true
MOCK_OTP_CODE=123456
# Real login codes (MOCK_OTP=false or production): same MiniMoth hook as Agarwal Online
MINIMOTH_HOOK_URL=
MINIMOTH_HOOK_TOKEN=

# Shown to customers for help with an order, e.g. 98xxxxxxxx
SHOP_PHONE=

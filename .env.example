# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/agarwal_fatake
# 32+ random characters, keep it stable: openssl rand -hex 32. Also signs login cookies.
AUTH_SECRET=
# 10-digit mobile numbers (comma separated) that get the /admin pages after logging in
ADMIN_PHONES=

# Codes go out only to create an account or set a new password (login is number + password).
# Development only: no SMS is sent and MOCK_OTP_CODE is the code. Ignored in production.
MOCK_OTP=true
MOCK_OTP_CODE=123456
# Real codes (MOCK_OTP=false or production): same MiniMoth hook as Agarwal Online
MINIMOTH_HOOK_URL=
MINIMOTH_HOOK_TOKEN=

# Shown to customers for help with an order, e.g. 98xxxxxxxx
SHOP_PHONE=

# ---- Email: Hostinger mailbox for verification and password-reset links; set all three or none ----
# Blank in development: the email (with its link) is printed in the server log instead.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- better-auth ----
# The site's exact address (https:// when live), for email links and Google's return trip.
# On Vercel it falls back to the production domain if left out.
APP_ORIGIN=http://127.0.0.1:3000
# Optional: a separate 32+ character secret for login cookies; AUTH_SECRET is used when blank.
BETTER_AUTH_SECRET=

# ---- Google sign-in: set both or neither; blank hides the button ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <APP_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
